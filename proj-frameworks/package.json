{
  "name": "brainlog-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "server": "npm run dev -w backend",
    "dev:all": "concurrently \"npm run server\" \"npm run dev\"",
    "build": "npm run build -w frontend",
    "preview": "npm run preview -w frontend",
    "server:build": "npm run build -w backend",
    "server:start": "npm run start -w backend",
    "prisma:generate": "npm run prisma:generate -w backend",
    "prisma:migrate": "npm run prisma:migrate -w backend",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
